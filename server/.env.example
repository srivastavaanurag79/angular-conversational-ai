PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Leave OPENAI_API_KEY empty to run fully offline with the built-in mock provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Auth
JWT_SECRET=dev-secret-change-me
JWT_TTL=7d

# Storage (SQLite file, created automatically)
DATABASE_FILE=./data/app.db

# Retrieval
RAG_TOP_K=4
RAG_CHUNK_SIZE=320
# Set to true to use real OpenAI embeddings instead of the local hashing embeddings.
RAG_REAL_EMBEDDINGS=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Agent
AGENT_MAX_TOOL_STEPS=3
AGENT_HISTORY_LIMIT=20
